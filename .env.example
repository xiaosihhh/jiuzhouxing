# 服务
PORT=8000
HOST=0.0.0.0


# 华为云智能体接口
AGENT_API_URL=https://your-modelarts-endpoint/v2/chat/completions
AGENT_API_KEY=your-agent-api-key
AGENT_MODEL=your-model-name
AGENT_TIMEOUT_MS=45000

# AgentArts Managed Agent（优先于普通 MaaS 调用）
AGENTARTS_CHAT_URL=https://your-agentarts-domain/runtimes/your-agent-id/invocations/v1/chat/completions
AGENTARTS_API_KEY=your-agentarts-api-key
AGENTARTS_API_KEY_HEADER=Authorization
AGENTARTS_API_KEY_PREFIX=Bearer
AGENTARTS_SKILLS=jzx-travel-planner

# 如果接口使用自定义鉴权头
AGENT_API_KEY_HEADER=Authorization
AGENT_API_KEY_PREFIX=Bearer

# 服务端认证。生产环境必须替换为随机长密钥
AUTH_SESSION_SECRET=replace-with-random-64-character-secret
AUTH_DEMO_CODE=true

# RDS for MySQL
DATABASE_URL=mysql://user:password@rds-host:3306/jiuzhou?charset=utf8mb4

# DCS for Redis
REDIS_URL=redis://user:password@dcs-host:6379/0

# OBS 对象存储
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_BUCKET=your-obs-bucket
OBS_ACCESS_KEY=your-obs-access-key
OBS_SECRET_KEY=your-obs-secret-key

